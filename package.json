{
  "name": "veil-messenger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "test:smoke": "node test/smoke.mjs",
    "test:browser": "node test/browser.mjs",
    "test:syntax": "node --check src/worker.js && node --check public/app.js && node --check test/smoke.mjs && node --check test/browser.mjs",
    "db:migrate:local": "wrangler d1 migrations apply veil-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply veil-db --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "wrangler": "^4.0.0"
  }
}
