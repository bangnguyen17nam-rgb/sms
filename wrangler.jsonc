{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sms",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veil-db",
      "database_id": "c5a0a867-9533-4724-b3e0-8b641197c1b6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "veil-attachments"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "veil-preview-db",
        "database_id": "a695c306-c8f1-4a0e-b503-c1f68e210a07"
      }
    ],
    "r2_buckets": [
      {
        "binding": "ATTACHMENTS",
        "bucket_name": "veil-preview-attachments"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
