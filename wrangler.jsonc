{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sms",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veil-db",
      "database_id": "88991546-d036-45cf-b2ef-5757fef2d684",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "veil-attachments"
    }
  ],
  "observability": {
    "enabled": true
  }
}
